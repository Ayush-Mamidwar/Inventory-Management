// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  unit      String   @default("pcs")
  limit     Decimal  @default(0) @db.Decimal(12, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billItems   BillItem[]
  stockUsages StockUsage[]
}

model Bill {
  id         String   @id @default(uuid()) @db.Uuid
  billNumber String?
  billDate   DateTime @default(now())
  settled    Boolean  @default(false)
  notes      String?
  supplier   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items BillItem[]

  @@index([billDate])
  @@index([settled])
}

model BillItem {
  id         String    @id @default(uuid()) @db.Uuid
  billId     String    @db.Uuid
  productId  String    @db.Uuid
  quantity   Decimal   @db.Decimal(12, 3)
  unitPrice  Decimal   @db.Decimal(12, 2)
  expiryDate DateTime?
  createdAt  DateTime  @default(now())

  bill        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockUsages StockUsage[]

  @@index([billId])
  @@index([productId])
  @@index([expiryDate])
}

model StockUsage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  billItemId String? @db.Uuid
  quantity  Decimal  @db.Decimal(12, 3)
  usedAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  billItem BillItem? @relation(fields: [billItemId], references: [id], onDelete: SetNull)

  @@index([productId, usedAt])
  @@index([billItemId])
}
